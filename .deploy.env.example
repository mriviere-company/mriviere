# Hostinger SSH credentials — copy to .deploy.env (gitignored) and fill in.
# Get them from hPanel → Avancé → Accès SSH.

# Your Hostinger SSH user, e.g. u123456789
HOSTINGER_SSH_USER=u123456789

# The hostname or IP. The domain works once the site is live.
HOSTINGER_SSH_HOST=rivierematthieu.com

# Hostinger uses 65002 for SSH on shared hosting (not the default 22).
HOSTINGER_SSH_PORT=65002

# Absolute path to the public_html (or app root) on the remote.
# Find it via: ssh -p 65002 u123…@rivierematthieu.com pwd
HOSTINGER_REMOTE_PATH=/home/u123456789/domains/rivierematthieu.com/public_html

# PHP binary on the remote — Hostinger ships several.
# Symfony 8 requires 8.3+; this project is tested with 8.4.
HOSTINGER_PHP_BIN=/usr/bin/php8.4
