# Template d'environnement — copier vers .env.local puis renseigner les vraies valeurs :
#   cp .env.example .env.local
# .env.local est gitignored ; ne jamais commiter de secret réel.

###> symfony/framework-bundle ###
# prod sur Hostinger, dev en local
APP_ENV=dev
# Générer avec : php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
APP_SECRET=replace_me_32_hex_chars
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Local : mysql://user:password@localhost:3306/mriviere?serverVersion=10.11.2-MariaDB&charset=utf8mb4
# Hostinger : mysql://uXXXXXXXXX_user:password@localhost:3306/uXXXXXXXXX_mriviere?serverVersion=10.11.2-MariaDB&charset=utf8mb4
DATABASE_URL="mysql://user:password@localhost:3306/mriviere?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Local : null://null — Hostinger : smtp://user:pass@smtp.hostinger.com:465
MAILER_DSN=null://null
###< symfony/mailer ###

###> app ###
# Prod : https://rivierematthieu.com
PUBLIC_BASE_URL=http://localhost:8000
FROM_EMAIL=contact@rivierematthieu.com
ADMIN_EMAIL=contact@rivierematthieu.com
###< app ###

###> stripe ###
# Compte Stripe Canada — tous les Price en CAD (voir docs/STRIPE.md)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_STANDARD=price_replace_me
STRIPE_PRICE_PREMIUM=price_replace_me
STRIPE_DASHBOARD_BASE=https://dashboard.stripe.com/test
###< stripe ###

###> super-admin (central dashboard) ###
# Issuer used in `iss` claim of EdDSA JWTs sent to client clones.
# Must match the value the clone has configured in its super_admin.yaml.
SUPER_ADMIN_ISSUER=http://localhost:8000
SUPER_ADMIN_PRIVATE_KEY=%kernel.project_dir%/var/keys/super_admin_private.pem
###< super-admin ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
