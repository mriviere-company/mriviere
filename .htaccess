# Project root — Hostinger mutualisé routing.
# Public files live under /public — this rewrites every request into it.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Send all traffic through public/index.php while keeping the original path
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to project root files. Patterns are anchored ($) to avoid
# false positives like Vite chunks named "packages-XXX.js" or "vite-YYY.js".
<FilesMatch "^(composer\.(json|lock|phar)|symfony\.lock|phpunit\.dist\.xml|playwright\.config\.ts|vite\.config\.ts|tsconfig.*\.json|package\.json|package-lock\.json|\..*)$">
    Require all denied
</FilesMatch>
